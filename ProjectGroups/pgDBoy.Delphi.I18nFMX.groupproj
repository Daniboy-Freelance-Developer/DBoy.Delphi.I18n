<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{8042BBDA-6D46-4F88-A69D-13FA4C6D945E}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="..\Samples\DBoy.I18n.FMX.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="..\Tests\DBoy.I18n.FMX.Tests.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="DBoy_I18n_FMX">
        <MSBuild Projects="..\Samples\DBoy.I18n.FMX.dproj"/>
    </Target>
    <Target Name="DBoy_I18n_FMX:Clean">
        <MSBuild Projects="..\Samples\DBoy.I18n.FMX.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DBoy_I18n_FMX:Make">
        <MSBuild Projects="..\Samples\DBoy.I18n.FMX.dproj" Targets="Make"/>
