    <Target Name="DBoy_I18n_FMX_Tests:Clean">
        <MSBuild Projects="..\Tests\DBoy.I18n.FMX.Tests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DBoy_I18n_FMX_Tests:Make">
        <MSBuild Projects="..\Tests\DBoy.I18n.FMX.Tests.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="DBoy_I18n_FMX;DBoy_I18n_FMX_Tests"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="DBoy_I18n_FMX:Clean;DBoy_I18n_FMX_Tests:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="DBoy_I18n_FMX:Make;DBoy_I18n_FMX_Tests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
